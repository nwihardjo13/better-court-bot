BETTER_VENUE_SLUG=islington-tennis-centre
BETTER_ACTIVITY_SLUG=highbury-tennis
BETTER_TIMEZONE=Europe/London

# Comma-separated explicit dates. Takes priority over days-ahead range.
# Example: 2026-08-01,2026-08-02
TARGET_DATES=

# Optional single-date fallback if TARGET_DATES and range variables are blank.
TARGET_DAYS_AHEAD=5

# Inclusive rolling range. Leave TARGET_DATES blank to use this.
# Example: 5 through 7 days from today.
TARGET_DAYS_AHEAD_FROM=5
TARGET_DAYS_AHEAD_TO=7

START_TIME_FROM=19:00
START_TIME_TO=21:00
MAX_PRICE_GBP=20

# Comma-separated Better location slugs in preference order.
PREFERRED_COURTS=highbury-fields-court-1,highbury-fields-court-2

HEADLESS=false
PROFILE_DIR=.playwright-profile
POLL_INTERVAL_MS=5000
