BETTER_VENUE_SLUG=islington-tennis-centre
BETTER_ACTIVITY_SLUG=highbury-tennis
BETTER_TIMEZONE=Europe/London

# Comma-separated explicit dates. Example: 2026-08-01,2026-08-02
TARGET_DATES=2026-08-01

# Optional fallback if TARGET_DATES is blank.
TARGET_DAYS_AHEAD=5

START_TIME_FROM=19:00
START_TIME_TO=21:00
MAX_PRICE_GBP=20

# Comma-separated Better location slugs in preference order.
PREFERRED_COURTS=highbury-fields-court-1,highbury-fields-court-2

HEADLESS=false
PROFILE_DIR=.playwright-profile
POLL_INTERVAL_MS=5000
